{
  "name": "motox-wiki",
  "private": true,
  "description": "MotoX Wiki public site build tools",
  "scripts": {
    "build:data": "python3 scripts/build-data.py",
    "build:web": "node scripts/build-web.mjs",
    "build": "npm run build:data && npm run build:css && npm run build:seo && npm run build:web",
    "watch:web": "node scripts/watch-web.mjs",
    "preview": "bash scripts/preview-wiki.sh",
    "setup:hooks": "bash scripts/setup-git-hooks.sh",
    "prepare": "bash scripts/setup-git-hooks.sh",
    "build:seo": "python3 scripts/build-seo-pages.py",
    "build:css": "node scripts/build-css.mjs"
  },
  "devDependencies": {
    "javascript-obfuscator": "^4.1.1"
  }
}
